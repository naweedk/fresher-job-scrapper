# ============================================================
# ENVIRONMENT VARIABLES – FRESHER JOBS INDIA
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ──────────────────────────────────────────────
# DATABASE (shared between API and ingestion)
# ──────────────────────────────────────────────
# NOTE: Port 5434 is used for Docker to avoid conflict with
# any locally installed PostgreSQL on the default port 5432.
DATABASE_URL="postgresql://postgres:local_dev_password@localhost:5434/fresher_jobs?schema=public"

# ──────────────────────────────────────────────
# POSTGRESQL DOCKER (docker-compose.yml)
# ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=fresher_jobs
POSTGRES_PORT=5434

# ──────────────────────────────────────────────
# NESTJS API (apps/api)
# ──────────────────────────────────────────────
PORT=3100
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────
# AI / LLM (apps/api and ingestion)
# Phase 2+ – leave blank for Phase 1
# ──────────────────────────────────────────────
GEMINI_API_KEY=
