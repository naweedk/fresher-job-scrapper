# ============================================================
# ENVIRONMENT VARIABLES - FRESHER JOBS INDIA
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ──────────────────────────────────────────────
# DATABASE (shared between API and ingestion)
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:local_dev_password@localhost:5434/fresher_jobs?schema=public"

# ──────────────────────────────────────────────
# POSTGRESQL DOCKER (docker-compose.yml)
# ──────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local_dev_password
POSTGRES_DB=fresher_jobs
POSTGRES_PORT=5434

# ──────────────────────────────────────────────
# NESTJS API (apps/api)
# ──────────────────────────────────────────────
PORT=3100
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────
# GOOGLE GEMINI AI
# ──────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ──────────────────────────────────────────────
# INGESTION CONFIGURATION
# ──────────────────────────────────────────────
INGESTION_BATCH_SIZE=50
INGESTION_REQUEST_TIMEOUT=30
INGESTION_MAX_RETRIES=3
INGESTION_RATE_LIMIT_DELAY=1.0
INGESTION_MAX_PAGES=5

# ──────────────────────────────────────────────
# CLASSIFICATION CONFIGURATION
# ──────────────────────────────────────────────
CLASSIFICATION_BATCH_SIZE=20
CLASSIFICATION_MAX_RETRIES=3
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70

# ──────────────────────────────────────────────
# LOGGING
# ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ──────────────────────────────────────────────
# NEXT.JS FRONTEND (apps/web)
# ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3100/api

