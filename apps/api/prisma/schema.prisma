// ============================================================
// Prisma Schema – Fresher Jobs India
// ============================================================
// Generator: Prisma Client (Node.js / TypeScript)
// Database:  PostgreSQL 16
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum SourceType {
  API
  RSS
  HTML
  OTHER
}

enum JobStatus {
  ACTIVE
  EXPIRED
  INACTIVE
}

enum JobType {
  INTERNSHIP
  FULL_TIME
  CONTRACT
  OTHER
}

enum ExperienceLevel {
  FRESHER
  ZERO_TO_ONE_YEAR
  ONE_TO_TWO_YEARS
  OTHER
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
  UNKNOWN
}

enum ClassificationStatus {
  PENDING
  COMPLETED
  FAILED
  REVIEW_REQUIRED
}

// ──────────────────────────────────────────────
// MODELS
// ──────────────────────────────────────────────

/// A hiring company associated with one or more job listings.
model Company {
  id        String   @id @default(uuid())
  name      String
  website   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@map("companies")
}

/// A data source from which job listings are collected.
model Source {
  id         String     @id @default(uuid())
  name       String
  sourceType SourceType
  baseUrl    String?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  jobs          Job[]
  ingestionLogs IngestionLog[]

  @@map("sources")
}

/// A single job or internship listing.
model Job {
  id           String    @id @default(uuid())
  companyId    String
  sourceId     String
  externalId   String?
  title        String
  description  String
  location     String?
  jobUrl       String
  canonicalUrl String?
  contentHash  String?
  postedAt     DateTime?
  expiresAt    DateTime?
  status       JobStatus @default(ACTIVE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company        Company            @relation(fields: [companyId], references: [id])
  source         Source             @relation(fields: [sourceId], references: [id])
  classification JobClassification?

  // ── Indexes ──────────────────────────────────
  @@index([title])
  @@index([location])
  @@index([status])
  @@index([postedAt])
  @@index([companyId])
  @@index([sourceId])
  // ── Uniqueness ───────────────────────────────
  // Prevents exact duplicate (sourceId + externalId) pairs
  // when externalId is present. Rows with NULL externalId
  // are excluded from this constraint in PostgreSQL because
  // NULLs are never considered equal.
  @@unique([sourceId, externalId])
  @@map("jobs")
}

/// LLM-generated classification metadata for a job listing.
model JobClassification {
  id              String               @id @default(uuid())
  jobId           String               @unique
  role            String?
  city            String?
  jobType         JobType?
  experienceLevel ExperienceLevel?
  workMode        WorkMode?
  skills          String[]
  confidence      Float?
  modelName       String?
  promptVersion   String?
  status          ClassificationStatus @default(PENDING)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([role])
  @@index([city])
  @@index([jobType])
  @@map("job_classifications")
}

/// Audit log for each ingestion run from a source.
model IngestionLog {
  id             String    @id @default(uuid())
  sourceId       String
  startedAt      DateTime
  completedAt    DateTime?
  fetchedCount   Int       @default(0)
  insertedCount  Int       @default(0)
  duplicateCount Int       @default(0)
  failedCount    Int       @default(0)
  status         String
  errorMessage   String?
  createdAt      DateTime  @default(now())

  source Source @relation(fields: [sourceId], references: [id])

  @@index([sourceId])
  @@index([startedAt])
  @@map("ingestion_logs")
}
